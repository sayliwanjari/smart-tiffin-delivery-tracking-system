<?php

require_once __DIR__ . '/../../config/session.php';
require_once __DIR__ . '/../../config/database.php';

header('Content-Type: application/json; charset=utf-8');

function jsonResponse($success, $message, $extra = [])
{
    http_response_code($success ? 200 : 400);

    echo json_encode(
        array_merge(
            [
                'success' => $success,
                'message' => $message
            ],
            $extra
        )
    );

    exit;
}


/*
 * Only accept AJAX POST requests.
 */
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {

    jsonResponse(
        false,
        'Invalid request method.'
    );
}


/*
 * Existing session.
 *
 * The browser never supplies dabbawala_id.
 */
$dabbawala_id = (int)(
    $_SESSION['dabbawala_id']
    ?? $_SESSION['user_id']
    ?? 0
);

if ($dabbawala_id <= 0) {

    jsonResponse(
        false,
        'Dabbawala authentication is required.'
    );
}


/*
 * Verify the session ID belongs to a real dabbawala.
 */
$stmt = $conn->prepare("
    SELECT id
    FROM dabbawalas
    WHERE id = ?
    LIMIT 1
");

if (!$stmt) {

    jsonResponse(
        false,
        'Unable to verify dabbawala account.'
    );
}

$stmt->bind_param(
    'i',
    $dabbawala_id
);

$stmt->execute();

$result = $stmt->get_result();

$dabbawala = $result->fetch_assoc();

$stmt->close();

if (!$dabbawala) {

    jsonResponse(
        false,
        'Dabbawala account could not be verified.'
    );
}


/*
 * Read JSON request.
 */
$raw = file_get_contents('php://input');

$data = json_decode(
    $raw,
    true
);

if (!is_array($data)) {

    jsonResponse(
        false,
        'Invalid location data.'
    );
}


/*
 * Latitude.
 */
$latitude = filter_var(
    $data['latitude'] ?? null,
    FILTER_VALIDATE_FLOAT
);


/*
 * Longitude.
 */
$longitude = filter_var(
    $data['longitude'] ?? null,
    FILTER_VALIDATE_FLOAT
);


/*
 * Validate coordinates.
 */
if (
    $latitude === false ||
    $longitude === false ||
    !is_finite((float)$latitude) ||
    !is_finite((float)$longitude)
) {

    jsonResponse(
        false,
        'Invalid GPS coordinates.'
    );
}

$latitude = (float)$latitude;
$longitude = (float)$longitude;

if ($latitude < -90 || $latitude > 90) {

    jsonResponse(
        false,
        'Latitude must be between -90 and 90.'
    );
}

if ($longitude < -180 || $longitude > 180) {

    jsonResponse(
        false,
        'Longitude must be between -180 and 180.'
    );
}


/*
 * Find an active delivery belonging to THIS dabbawala.
 *
 * No assignment_id is accepted from the browser.
 */
$stmt = $conn->prepare("
    SELECT id
    FROM delivery_assignments
    WHERE dabbawala_id = ?
    AND assignment_status IN ('assigned', 'accepted')
    ORDER BY id DESC
    LIMIT 1
");

if (!$stmt) {

    jsonResponse(
        false,
        'Unable to find an active delivery.'
    );
}

$stmt->bind_param(
    'i',
    $dabbawala_id
);

$stmt->execute();

$result = $stmt->get_result();

$assignment = $result->fetch_assoc();

$stmt->close();

if (!$assignment) {

    jsonResponse(
        false,
        'No active delivery is assigned to you.'
    );
}

$assignment_id = (int)$assignment['id'];


/*
 * Store the location.
 *
 * recorded_at is generated by MySQL using CURRENT_TIMESTAMP.
 * This prevents the client from controlling the database timestamp.
 */
$stmt = $conn->prepare("
    INSERT INTO gps_locations
    (
        assignment_id,
        dabbawala_id,
        latitude,
        longitude
    )
    VALUES (?, ?, ?, ?)
");

if (!$stmt) {

    jsonResponse(
        false,
        'Unable to prepare GPS storage request.'
    );
}

$stmt->bind_param(
    'iidd',
    $assignment_id,
    $dabbawala_id,
    $latitude,
    $longitude
);

if (!$stmt->execute()) {

    $stmt->close();

    jsonResponse(
        false,
        'Unable to save GPS location.'
    );
}

$location_id = $stmt->insert_id;

$stmt->close();


jsonResponse(
    true,
    'Location updated successfully.',
    [
        'location_id' => (int)$location_id,
        'latitude' => $latitude,
        'longitude' => $longitude
    ]
);